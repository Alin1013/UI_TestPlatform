{
  "name": "enterprise-ui-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Hybrid Playwright and Midscene.js end-to-end automation framework",
  "scripts": {
    "clean": "rimraf playwright-report midscene_report test-results",
    "test": "playwright test --project=smoke",
    "test:smoke": "playwright test --project=smoke",
    "test:ai": "node scripts/require-ai-config.mjs && playwright test --project=visual",
    "demo": "node scripts/serve-demo.mjs",
    "workbench": "node scripts/serve-workbench.mjs",
    "test:debug": "playwright test --project=smoke --headed",
    "test:report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@midscene/web": "^1.16.1",
    "@playwright/test": "^1.64.1",
    "dotenv": "^18.0.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
