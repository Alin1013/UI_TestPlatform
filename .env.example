# 默认使用随仓库提供的本地演示站点；接入业务时只填写获准的测试环境。
APP_BASE_URL=http://127.0.0.1:4173
# 配置外部 APP_BASE_URL 时必须列出精确主机名，多个主机用逗号分隔。
APP_ALLOWED_HOSTS=

# 工作台业务数据 PostgreSQL 连接串；用例、步骤、工作流、用户和环境配置均写入此库。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ui_test_platform
# 工作台默认用户（没有登录模块时用于本地身份归属）。
WORKBENCH_USER_EMAIL=alin@example.com
WORKBENCH_USER_NAME=Alin Li

# 可选并发上限；CI 未填写时默认使用两个 worker。
PLAYWRIGHT_WORKERS=

# 密钥只放在本地 .env 或 Jenkins 凭据中，严禁提交到 Git。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MIDSCENE_MODEL_NAME=
